# Environnements virtuels
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
*.pyo

# PyInstaller
build/
dist/
*.spec
# Exception : spec macOS volontairement versionné (dans packaging/macos/,
# voir packaging/macos/README.md), contrairement aux .spec auto-générés.
!packaging/macos/LaserStudioPro.spec
# Idem pour le spec partagé Windows / Linux (packaging/windows/build.bat,
# packaging/linux/build-linux.sh, CI release.yml).
!packaging/pyinstaller/LaserStudioPro.spec
# Idem pour le spec du paquet RPM de Fedora (packaging/fedora/README.md).
!packaging/fedora/laser-studio-pro.spec
build_venv/

# Projets utilisateur (sauvegardes .json de Laser Studio Pro)
# Retire cette ligne si tu veux versionner tes propres projets d'exemple
*.json
# Exception : fiches des modèles de la bibliothèque (info.json, _category.json).
!src/laser_studio/resources/library/**/*.json
# Exception : réglages partagés de Claude Code (hook de mise à jour du dépôt).
!.claude/settings.json

# Fichiers système
.DS_Store
Thumbs.db

# Environnements / IDE
.vscode/
.idea/
Output/ 
dist/ 
build/ 
*.exe 
Output/ 
dist/ 
build/ 
*.exe 
.aider*
*.zip

# Métadonnées laissées par pip install -e / pip wheel
*.egg-info/

# Guide de démarrage compilé (pandoc -d pdf.yaml dans docs/guide/)
docs/guide/*.pdf
