diff -ruN a/src/laser_studio/ui/dialogs/box_generator/preview_3d.py b/src/laser_studio/ui/dialogs/box_generator/preview_3d.py
--- a/src/laser_studio/ui/dialogs/box_generator/preview_3d.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/laser_studio/ui/dialogs/box_generator/preview_3d.py	2026-11-16 07:20:08.587160780 +0000
@@ -0,0 +1,187 @@
+"""Aperçu 3D de la boîte assemblée : rendu logiciel (QPainter, aucun OpenGL), par l'algorithme du peintre.
+
+Le calcul (faces, tri, projection) est dans `laser_studio.vector.box_3d`, sans Qt. Ici : le widget, qui garde
+l'angle de vue (glisser pour tourner, molette pour zoomer, double-clic pour revenir à la vue de départ) et
+l'ouverture du couvercle."""
+import math
+
+from PyQt6.QtCore import QPointF, Qt
+from PyQt6.QtGui import QColor, QImage, QPainter, QPainterPath, QPen
+from PyQt6.QtWidgets import QWidget
+
+from laser_studio.vector import box_3d
+from laser_studio.vector import box_generator as bg
+
+DEFAULT_YAW = math.radians(-35.0)
+DEFAULT_PITCH = math.radians(25.0)
+_MAX_PITCH = math.radians(89.0)
+
+
+def view_extent(faces_list):
+    """(centre (x, y, z), rayon) d'une sphère qui contient toutes les faces de toutes les listes données :
+    l'échelle ne change plus quand on tourne la vue ou qu'on ouvre le couvercle."""
+    pts = [q for faces in faces_list for face in faces for q in face.points]
+    lo = [min(q[i] for q in pts) for i in range(3)]
+    hi = [max(q[i] for q in pts) for i in range(3)]
+    centre = tuple((a + b) / 2.0 for a, b in zip(lo, hi))
+    radius = max(math.dist(centre, q) for q in pts)
+    return centre, max(radius, 1.0)
+
+
+class Box3DView(QWidget):
+    """Rendu 3D ; `set_box()` fournit la boîte, `set_open_angle()` ouvre le couvercle."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.faces = []
+        self._params = None
+        self._result = None
+        self._open = 0.0
+        self._explode = 0.0
+        self._material = box_3d.DEFAULT_MATERIAL
+        self._yaw, self._pitch, self._zoom = DEFAULT_YAW, DEFAULT_PITCH, 1.0
+        self._centre, self._radius = (0.0, 0.0, 0.0), 1.0
+        self._drag = None
+        self._error = ""
+        self.setMinimumSize(320, 280)
+
+    # ------------------------------------------------------------------
+    def set_box(self, params, result):
+        self._params, self._result, self._error = params, result, ""
+        self._rebuild(refit=True)
+
+    def set_error(self, message):
+        self._params = self._result = None
+        self.faces, self._error = [], message
+        self.update()
+
+    def set_open_angle(self, degrees):
+        self._open = float(degrees)
+        if self._result is not None:
+            self._rebuild(refit=False)
+
+    def set_explode(self, percent):
+        """Vue éclatée : 0 = boîte assemblée, 100 = pièces écartées au maximum."""
+        self._explode = min(max(float(percent), 0.0), 100.0) / 100.0
+        if self._result is not None:
+            self._rebuild(refit=False)
+
+    def set_material(self, key):
+        self._material = key if key in box_3d.MATERIALS else box_3d.DEFAULT_MATERIAL
+        self.update()
+
+    def _rebuild(self, refit):
+        self.faces = box_3d.build_faces(self._params, self._result, self._open, self._explode)
+        if refit:
+            lists = [box_3d.build_faces(self._params, self._result, 0.0, 1.0)]
+            if bg.lid_kind(self._params) in box_3d.OPENABLE_LIDS:
+                lists.append(box_3d.build_faces(self._params, self._result, 100.0, 1.0))
+            self._centre, self._radius = view_extent(lists)
+        self.update()
+
+    def reset_view(self):
+        self._yaw, self._pitch, self._zoom = DEFAULT_YAW, DEFAULT_PITCH, 1.0
+        self.update()
+
+    # ------------------------------------------------------------------
+    def mousePressEvent(self, event):
+        self._drag = (event.position().x(), event.position().y())
+
+    def mouseMoveEvent(self, event):
+        if self._drag is None:
+            return
+        x, y = event.position().x(), event.position().y()
+        self._yaw -= (x - self._drag[0]) * 0.01
+        self._pitch = min(max(self._pitch + (y - self._drag[1]) * 0.01, -_MAX_PITCH), _MAX_PITCH)
+        self._drag = (x, y)
+        self.update()
+
+    def mouseReleaseEvent(self, _event):
+        self._drag = None
+
+    def mouseDoubleClickEvent(self, _event):
+        self.reset_view()
+
+    def wheelEvent(self, event):
+        step = 1.0 + 0.0012 * event.angleDelta().y()
+        self._zoom = min(max(self._zoom * step, 0.3), 6.0)
+        self.update()
+
+    # ------------------------------------------------------------------
+    def paintEvent(self, _event):
+        painter = QPainter(self)
+        self._paint(painter, self.width(), self.height(), self.palette().window().color())
+
+    def render_image(self, width=1600, height=1200, background=None):
+        """Le rendu actuel (même angle, ouverture, éclaté et matériau) dans une QImage, pour l'export."""
+        image = QImage(int(width), int(height), QImage.Format.Format_ARGB32)
+        painter = QPainter(image)
+        self._paint(painter, int(width), int(height), background or QColor(255, 255, 255))
+        painter.end()
+        return image
+
+    def save_png(self, path, width=1600, height=1200):
+        return self.render_image(width, height).save(path, "PNG")
+
+    def _paint(self, painter, width, height, background):
+        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
+        painter.fillRect(0, 0, width, height, background)
+        if not self.faces:
+            painter.setPen(QColor(217, 83, 79))
+            painter.drawText(self.rect().adjusted(14, 14, -14, -14),
+                             int(Qt.AlignmentFlag.AlignCenter.value) | int(Qt.TextFlag.TextWordWrap.value), self._error)
+            return
+        base, grain = box_3d.MATERIALS[self._material]
+        scale = min(width, height) / (2.0 * self._radius) * 0.9 * self._zoom
+        cx, cy, _ = box_3d.project_point(self._centre, self._yaw, self._pitch)
+        mid_x, mid_y = width / 2.0, height / 2.0
+
+        def screen(point):
+            return QPointF(mid_x + (point[0] - cx) * scale, mid_y - (point[1] - cy) * scale)
+
+        for _face, pts, holes, shade in box_3d.visible_faces(self.faces, self._yaw, self._pitch):
+            path = QPainterPath()
+            for loop in [pts] + holes:
+                path.moveTo(screen(loop[0]))
+                for q in loop[1:]:
+                    path.lineTo(screen(q))
+                path.closeSubpath()
+            path.setFillRule(Qt.FillRule.OddEvenFill)
+            fill = QColor(*(min(255, int(c * shade)) for c in base))
+            painter.setPen(QPen(QColor(*(int(c * 0.5) for c in fill.getRgb()[:3])), 0.6))
+            painter.setBrush(fill)
+            painter.drawPath(path)
+            if grain > 0.0:
+                self._draw_grain(painter, path, pts, scale, fill, grain, screen)
+
+    @staticmethod
+    def _draw_grain(painter, path, pts, scale, fill, grain, screen):
+        """Veinage : fines lignes parallèles au plus long côté de la face, limitées à la face (seulement les
+        grandes faces : sur les tranches minces, elles ne se verraient pas)."""
+        xs = [q[0] for q in pts]
+        ys = [q[1] for q in pts]
+        if (max(xs) - min(xs)) * (max(ys) - min(ys)) * scale * scale < 900.0:
+            return
+        best, direction = 0.0, (1.0, 0.0)
+        for a, b in zip(pts, pts[1:] + pts[:1]):
+            length = math.hypot(b[0] - a[0], b[1] - a[1])
+            if length > best:
+                best, direction = length, ((b[0] - a[0]) / length, (b[1] - a[1]) / length)
+        normal = (-direction[1], direction[0])
+        cxm, cym = (max(xs) + min(xs)) / 2.0, (max(ys) + min(ys)) / 2.0
+        half = math.hypot(max(xs) - min(xs), max(ys) - min(ys)) / 2.0
+        step = 2.2
+        n = int(half / step)
+        r, g, b, _a = fill.getRgb()
+        painter.save()
+        painter.setClipPath(path)
+        for i in range(-n, n + 1):
+            wobble = 0.35 * math.sin(i * 1.7) + 0.2 * math.sin(i * 0.43)
+            off = i * step + wobble
+            alpha = int(18 + 30 * grain * (0.5 + 0.5 * math.sin(i * 2.3 + 1.0)))
+            pen = QPen(QColor(int(r * 0.62), int(g * 0.6), int(b * 0.55), alpha), 0.7)
+            painter.setPen(pen)
+            ox, oy = cxm + normal[0] * off, cym + normal[1] * off
+            painter.drawLine(screen((ox - direction[0] * half, oy - direction[1] * half)),
+                             screen((ox + direction[0] * half, oy + direction[1] * half)))
+        painter.restore()
diff -ruN a/src/laser_studio/vector/box_3d.py b/src/laser_studio/vector/box_3d.py
--- a/src/laser_studio/vector/box_3d.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/laser_studio/vector/box_3d.py	2026-11-16 07:20:08.563955538 +0000
@@ -0,0 +1,421 @@
+"""Modèle 3D de la boîte assemblée, sans Qt : de quoi dessiner un rendu en perspective de l'aperçu.
+
+Chaque panneau du résultat de `box_generator.build_box` est une plaque de `thickness` mm : on la replace dans
+l'espace de la boîte (X largeur, Y profondeur, Z hauteur, Y = 0 sur la façade) et on en tire des faces planes
+(deux faces larges, un quadrilatère par arête de contour ou de trou). Le dessin les trie de l'arrière vers l'avant
+(`visible_faces`) et les remplit : algorithme du peintre, suffisant pour un aperçu.
+
+Le couvercle s'ouvre : charnière à axe (plaques rigides tournant autour de la tige), charnière vivante
+(la zone de charnière se courbe, longueur constante) ; angle 0 = fermé."""
+import math
+
+from laser_studio.vector import box_generator as bg
+
+OPENABLE_LIDS = ("hinged", "pinned")
+MAX_OPEN_DEG = 110.0
+_ZONE_SLICES = 10                       # tranches de la zone courbe de la charnière vivante
+
+
+class Face:
+    """Polygone plan de l'espace (`points`, avec éventuellement des `holes`), de normale sortante `normal`."""
+    __slots__ = ("points", "holes", "normal", "name")
+
+    def __init__(self, points, holes, normal, name):
+        self.points, self.holes, self.normal, self.name = points, holes, normal, name
+
+
+# ----------------------------------------------------------------------
+# Placement d'un panneau (u, v, f) -> (x, y, z) ; f = 0..1 dans l'épaisseur
+# ----------------------------------------------------------------------
+def panel_mapping(name, p, result):
+    """Fonction (u, v, f) -> (x, y, z) du panneau `name`, boîte fermée."""
+    W, D, H = result.outer
+    t, cl = p.thickness, p.clearance
+    kind = bg.lid_kind(p)
+    half = cl / 2.0
+    if name == "front":
+        return lambda u, v, f: (u, f * t, v)
+    if name == "back":
+        return lambda u, v, f: (W - u, D - t + f * t, v)
+    if name == "left":
+        return lambda u, v, f: (f * t, D - u, v)
+    if name == "right":
+        return lambda u, v, f: (W - t + f * t, u, v)
+    if name == "bottom":
+        return lambda u, v, f: (W - u, v, f * t)
+    if name == "top":
+        if kind == "sliding":
+            _, front_h = bg.wall_heights(p, H)
+            return lambda u, v, f: (half + u, v, front_h + half + f * t)
+        return lambda u, v, f: (u, v, H - t + f * t)
+    if name == "lip":
+        return lambda u, v, f: (t + half + u, t + half + v, H - 2 * t + f * t)
+    if name.startswith("hinge"):                        # plaque de charnière à axe : plan YZ
+        i, j = (int(x) - 1 for x in name[len("hinge"):].split("_"))
+        x0 = bg.pin_hinge_columns(p, W)[i][j][0]
+        return lambda u, v, f: (x0 + f * t, u, v)
+    if name.startswith("magnet_"):                      # plaques d'aimant : plan XY
+        side, number = name[len("magnet_"):].rstrip("0123456789"), int(name[len("magnet_"):].lstrip("lidwa"))
+        size, xs = bg.magnet_layout(p, W)
+        x0 = xs[number - 1] - size / 2.0
+        if side == "lid":
+            return lambda u, v, f: (x0 + u, t + half + v, H - 2 * t + f * t)
+        return lambda u, v, f: (x0 + u, t + v, H - 3 * t + f * t)
+    if name.startswith("foot"):                         # pieds : plaques empilées sous le fond (z < 0)
+        i, layer = (int(x) for x in name[len("foot"):].split("_"))
+        x0, y0 = bg.foot_origins(p, W, D)[i - 1]
+        return lambda u, v, f: (x0 + u, y0 + v, -layer * t + f * t)
+    if name.startswith("divider_x"):
+        pos = bg.divider_positions(W, int(p.dividers_x), t, p.ratios_x)[int(name[len("divider_x"):]) - 1]
+        return lambda u, v, f: (pos + f * t, u, v)
+    if name.startswith("divider_y"):
+        pos = bg.divider_positions(D, int(p.dividers_y), t, p.ratios_y)[int(name[len("divider_y"):]) - 1]
+        return lambda u, v, f: (u, pos + f * t, v)
+    raise KeyError(name)
+
+
+def _is_lid_part(name, p, result):
+    """Vrai pour une pièce qui suit le couvercle quand il s'ouvre."""
+    kind = bg.lid_kind(p)
+    if name == "top":
+        return kind == "pinned"
+    if name.startswith("magnet_lid"):
+        return kind in OPENABLE_LIDS
+    if name.startswith("hinge") and kind == "pinned":
+        i, j = (int(x) - 1 for x in name[len("hinge"):].split("_"))
+        return not bg.pin_hinge_columns(p, result.outer[0])[i][j][1]
+    return False
+
+
+def _rotation(axis, degrees):
+    """Rotation autour d'un axe parallèle à X passant par (y, z) = axis : le bord avant du couvercle monte."""
+    phi = -math.radians(degrees)
+    c, s = math.cos(phi), math.sin(phi)
+    ay, az = axis
+
+    def apply(point):
+        x, y, z = point
+        dy, dz = y - ay, z - az
+        return (x, ay + dy * c - dz * s, az + dy * s + dz * c)
+
+    def apply_vec(vec):
+        x, dy, dz = vec
+        return (x, dy * c - dz * s, dy * s + dz * c)
+
+    return apply, apply_vec
+
+
+# ----------------------------------------------------------------------
+# Charnière vivante : la zone de charnière se courbe (longueur constante)
+# ----------------------------------------------------------------------
+class LivingHinge:
+    """Ligne moyenne de la zone de charnière, dans le plan (y, z) : part du haut de la paroi arrière, cap vers +Z,
+    et tourne vers l'avant (-Y) de (90° - ouverture) en tout."""
+
+    def __init__(self, p, result, open_deg):
+        W, D, H = result.outer
+        self.t = p.thickness
+        self.length = p.hinge_length
+        self.wall_top = bg.wall_heights(p, H)[1]
+        self.y0 = D - self.t / 2.0
+        self.bend = math.radians(90.0 - open_deg)            # courbure totale ; 0 = tout droit
+        self.start = self.wall_top + self.length             # v du début du couvercle
+
+    def centre(self, s):
+        """(y, z, cap) du point d'abscisse s sur la ligne moyenne (cap : angle de la tangente depuis +Y)."""
+        psi0 = math.pi / 2.0
+        k = self.bend / self.length
+        psi = psi0 + k * s
+        if abs(k) < 1e-9:
+            return self.y0, self.wall_top + s, psi0
+        return (self.y0 + (math.sin(psi) - math.sin(psi0)) / k,
+                self.wall_top + (math.cos(psi0) - math.cos(psi)) / k, psi)
+
+    def point(self, v, f):
+        """(y, z) du point de la paroi arrière placé en (v, f), pour v >= le début de la zone."""
+        t = self.t
+        if v <= self.wall_top + 1e-12:
+            return self.y0 + (f - 0.5) * t, v
+        s = min(v - self.wall_top, self.length)
+        y, z, psi = self.centre(s)
+        extra = max(0.0, v - self.start)                      # suite à plat : le couvercle
+        y += extra * math.cos(psi)
+        z += extra * math.sin(psi)
+        nx, nz = math.cos(psi - math.pi / 2.0), math.sin(psi - math.pi / 2.0)
+        return y + (f - 0.5) * t * nx, z + (f - 0.5) * t * nz
+
+    def lid_transform(self):
+        """Mouvement rigide qui amène le repère du couvercle fermé à sa position ouverte."""
+        y_end, z_end, _ = self.centre(self.length)
+        y_closed = LivingHinge.__new__(LivingHinge)
+        y_closed.__dict__.update(self.__dict__)
+        y_closed.bend = math.pi / 2.0
+        y_c, z_c, _ = y_closed.centre(self.length)
+        phi = self.bend - math.pi / 2.0                       # = -ouverture
+        c, s = math.cos(phi), math.sin(phi)
+        ty = y_end - (y_c * c - z_c * s)
+        tz = z_end - (y_c * s + z_c * c)
+
+        def apply(point):
+            x, y, z = point
+            return (x, y * c - z * s + ty, y * s + z * c + tz)
+
+        def apply_vec(vec):
+            x, dy, dz = vec
+            return (x, dy * c - dz * s, dy * s + dz * c)
+
+        return apply, apply_vec
+
+
+# ----------------------------------------------------------------------
+# Géométrie plane
+# ----------------------------------------------------------------------
+def _clip_loop(loop, v0, v1):
+    """Contour fermé découpé à v0 <= v <= v1 (Sutherland-Hodgman). Peut être vide."""
+    def clip(points, keep, edge):
+        out = []
+        for i, cur in enumerate(points):
+            prev = points[i - 1]
+            a, b = keep(prev), keep(cur)
+            if a != b:
+                k = (edge - prev[1]) / (cur[1] - prev[1])
+                out.append((prev[0] + k * (cur[0] - prev[0]), edge))
+            if b:
+                out.append(cur)
+        return out
+
+    pts = list(loop)
+    if v0 > -1e8:
+        pts = clip(pts, lambda q: q[1] >= v0 - 1e-12, v0)
+    if pts and v1 < 1e8:
+        pts = clip(pts, lambda q: q[1] <= v1 + 1e-12, v1)
+    return pts if len(pts) >= 3 else []
+
+
+def _clip_segment(a, b, v0, v1):
+    """Segment ab restreint à v0 <= v <= v1, ou None."""
+    lo, hi = 0.0, 1.0
+    dv = b[1] - a[1]
+    if abs(dv) < 1e-12:
+        return (a, b) if v0 - 1e-9 <= a[1] <= v1 + 1e-9 else None
+    for edge, sign in ((v0, 1), (v1, -1)):
+        k = (edge - a[1]) / dv
+        if sign * dv > 0:
+            lo = max(lo, k)
+        else:
+            hi = min(hi, k)
+    if hi - lo < 1e-9:
+        return None
+    return ((a[0] + lo * (b[0] - a[0]), a[1] + lo * dv), (a[0] + hi * (b[0] - a[0]), a[1] + hi * dv))
+
+
+def _unit(vec):
+    n = math.sqrt(sum(c * c for c in vec))
+    return tuple(c / n for c in vec) if n > 1e-12 else (0.0, 0.0, 0.0)
+
+
+def _faces_of_slice(panel, fn, v0, v1, after, after_vec):
+    """Faces de la tranche v0..v1 du panneau, placées par `fn` puis par le mouvement `after` (ou None)."""
+    place = (lambda u, v, f: after(fn(u, v, f))) if after else fn
+    loops = [panel.cut] + list(panel.holes)
+    faces = []
+    clipped = [_clip_loop(loop, v0, v1) for loop in loops]
+    if clipped[0]:
+        cu = sum(q[0] for q in clipped[0]) / len(clipped[0])
+        cv = sum(q[1] for q in clipped[0]) / len(clipped[0])
+        a, b = place(cu, cv, 0.0), place(cu, cv, 1.0)
+        thick = _unit((b[0] - a[0], b[1] - a[1], b[2] - a[2]))
+        holes = [h for h in clipped[1:] if h]
+        for f, sign in ((0.0, -1.0), (1.0, 1.0)):
+            faces.append(Face([place(u, v, f) for u, v in clipped[0]],
+                              [[place(u, v, f) for u, v in h] for h in holes],
+                              tuple(sign * c for c in thick), panel.name))
+    for loop in loops:                                          # matière à gauche du sens de parcours
+        for i, a in enumerate(loop):
+            b = loop[(i + 1) % len(loop)]
+            seg = _clip_segment(a, b, v0, v1)
+            if seg is None:
+                continue
+            (au, av), (bu, bv) = seg
+            du, dv = bu - au, bv - av
+            length = math.hypot(du, dv)
+            if length < 1e-9:
+                continue
+            mu, mv = (au + bu) / 2.0, (av + bv) / 2.0
+            nu, nv = dv / length, -du / length                  # normale sortante de la matière
+            o = place(mu, mv, 0.5)
+            p2 = place(mu + 0.05 * nu, mv + 0.05 * nv, 0.5)
+            normal = _unit((p2[0] - o[0], p2[1] - o[1], p2[2] - o[2]))
+            faces.append(Face([place(au, av, 0.0), place(bu, bv, 0.0), place(bu, bv, 1.0), place(au, av, 1.0)],
+                              [], normal, panel.name))
+    return faces
+
+
