+        self.assertGreaterEqual(len(result.index), 5)
+        seen = set()
+        for text, x, y, size in result.index:
+            number = int(text)
+            self.assertNotIn(number, seen)
+            seen.add(number)
+            panel = result.panels[number - 1]
+            w, h = 0.7 * size * len(text), size
